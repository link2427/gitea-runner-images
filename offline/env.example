# URL of your Gitea server, reachable from this host AND from job containers.
# Do not use localhost unless Gitea runs on this host's network namespace.
GITEA_INSTANCE_URL=http://gitea.example.internal:3000

# Gitea > Site Administration (or Org/Repo Settings) > Actions > Runners >
# Create new runner. Only used for the first registration.
GITEA_RUNNER_REGISTRATION_TOKEN=

# Optional: name shown in Gitea's runner list.
GITEA_RUNNER_NAME=offline-runner

# Optional: comma-separated extra labels, e.g.
# EXTRA_RUNNER_LABELS=self-hosted,big-box:docker://runner-cpp:1.0.0
EXTRA_RUNNER_LABELS=

# Optional: a Gitea access token (scopes write:organization and
# write:repository, from an account allowed to create organizations) used to
# import the bundled actions. Leave empty to be prompted, or skip importing.
GITEA_ACTIONS_TOKEN=
